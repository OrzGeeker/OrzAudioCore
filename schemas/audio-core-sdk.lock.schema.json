{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/OrzGeeker/OrzAudioCore/schemas/audio-core-sdk.lock.schema.json",
  "title": "OrzAudioCore SDK lockfile",
  "type": "object",
  "required": ["schemaVersion", "repository", "version", "tag", "commit", "profiles", "assets"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "repository": { "type": "string", "format": "uri" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$" },
    "tag": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["cacheNamespace", "fingerprint", "formats", "decoders"],
        "additionalProperties": false,
        "properties": {
          "cacheNamespace": { "type": "string", "pattern": "^orzaudio-[^-]+-(builtin-lite|full|server)-[0-9a-f]{12}$" },
          "fingerprint": { "type": "string" },
          "formats": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "decoders": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "version"],
              "additionalProperties": false,
              "properties": { "id": { "type": "string" }, "version": { "type": "string" } }
            }
          }
        }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "platform", "profile", "sha256"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^OrzAudioCore-[0-9A-Za-z.+-]+-[a-z0-9_-]+-(builtin-lite|full|server)(\\.xcframework)?\\.(tar\\.gz|tgz|zip|aar)$" },
          "platform": { "enum": ["macos-arm64", "macos-x86_64", "linux-x86_64", "linux-arm64", "windows-x86_64", "apple", "ios", "android", "web"] },
          "profile": { "enum": ["builtin-lite", "full", "server"] },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "url": { "type": "string", "format": "uri" }
        }
      }
    }
  }
}
